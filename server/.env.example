PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Copy this file to server/.env. Keep SMTP credentials on the server only.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=webstead.in@gmail.com
# For Gmail, use an app password from the sender account.
EMAIL_PASSWORD=
EMAIL_FROM=webstead.in@gmail.com
CONTACT_RECEIVER=webstead.in@gmail.com
# On Render Free, use a Web3Forms access key generated for the recipient email.
# HTTPS delivery takes priority over SMTP when this value is set.
WEB3FORMS_ACCESS_KEY=
